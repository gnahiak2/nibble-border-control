{
  "name": "nibble-border-control",
  "version": "0.1.0",
  "description": "nibble, but border control — a slack bot that interviews new arrivals and stamps visas into the approved channel",
  "type": "module",
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.4.0",
    "@slack/types": "^2.14.0",
    "@slack/web-api": "^7.8.0",
    "dotenv": "^16.4.5",
    "install": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
