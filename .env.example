SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# channel people join first (the bot greets them here)
WELCOME_CHANNEL_ID=C...
# channel they get invited to once approved
APPROVED_CHANNEL_ID=C...

# optional: your slack user id (U...). if set, every application is DMed to you
# with approve/deny buttons. if blank, agreeing to the clause = auto-approved.
OWNER_SLACK_ID=

# confidentiality undertaking every applicant must sign (see src/agreement.ts)
# your real name: the person they're making the promise to
OWNER_LEGAL_NAME=
# fixed amount they agree to pay per breach, e.g. "$500 USD". blank = no fixed amount
BREACH_FINE=
# optional, e.g. "the laws of the State of California"
GOVERNING_LAW=
# where signatures are recorded (append-only, one JSON per line). back this up.
AGREEMENTS_FILE=data/agreements.jsonl
