# slack app tokens (https://api.slack.com/apps → your app → OAuth & Permissions / Basic Information)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# channel where arrivals get the welcome message + interview button (bot must be a member)
WELCOME_CHANNEL_ID=C0123456789

# channel that passing applicants get invited to (bot must be a member)
APPROVED_CHANNEL_ID=C0987654321

# command code api key (https://commandcode.ai/settings/keys) — every plan except Go has api
# access. leave blank to use the key stored by `cmd login` in ~/.commandcode/auth.json
CMD_API_KEY=

# model id from https://api.commandcode.ai/provider/v1/models (default is the catalog's haiku)
AI_MODEL=claude-haiku-5-5

# set to 1 for a scripted interview with no ai calls — useful for testing the slack flow
AI_MOCK=
